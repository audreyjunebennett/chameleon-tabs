{
  "manifest_version": 3,
  "name": "Desktop App Tabs",
  "version": "0.3.14",
  "permissions": [
    "nativeMessaging",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Desktop App Tabs",
    "default_popup": "picker.html",
    "default_icon": {
      "16": "icons/toolbar-16.png",
      "32": "icons/toolbar-32.png"
    }
  },
  "key": "",
  "description": "Bring your desktop apps into Chrome tabs.",
  "icons": {
    "16": "icons/chameleon-16.png",
    "32": "icons/chameleon-32.png",
    "48": "icons/chameleon-48.png",
    "128": "icons/chameleon-128.png"
  }
}
